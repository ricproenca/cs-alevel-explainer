---
import type { Algorithm } from "../lib/stepper";

interface Props {
  algorithms: Algorithm[];
  // Which drawing of the data structure to show.
  visual: "stack" | "queue" | "circular-queue";
  // Variables listed beside the drawing, e.g. ["StackSize", "Item"].
  variables: string[];
}

const { algorithms, visual, variables } = Astro.props;
const scenarios = algorithms[0].scenarios;
const data = JSON.stringify(algorithms).replace(/</g, "\\u003c");
---

<div
  class="stepper"
  data-stepper
  data-visual={visual}
  data-variables={JSON.stringify(variables)}
>
  <script type="application/json" data-stepper-data set:html={data} />

  <p class="stepper__choice-label" id="stepper-algorithm-label">Algorithm</p>
  <div class="stepper__tabs" role="group" aria-labelledby="stepper-algorithm-label">
    {
      algorithms.map((algorithm, index) => (
        <button
          type="button"
          class="stepper__tab"
          data-algorithm={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {algorithm.label}
        </button>
      ))
    }
  </div>
  <p class="stepper__summary" data-algorithm-note></p>

  <p class="stepper__choice-label" id="stepper-example-label">Example</p>
  <div class="stepper__tabs" role="group" aria-labelledby="stepper-example-label">
    {
      scenarios.map((scenario, index) => (
        <button
          type="button"
          class="stepper__tab"
          data-scenario={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {scenario.label}
        </button>
      ))
    }
  </div>
  <p class="stepper__summary" data-summary></p>

  <p class="stepper__choice-label" id="stepper-operations-label">Main program</p>
  <ol class="ops" data-operations aria-labelledby="stepper-operations-label"></ol>

  <div class="stepper__grid">
    <div class="stepper__code" data-code tabindex="0" role="region" aria-label="Python code">
      <ol class="code" data-code-lines></ol>
    </div>

    <div class="stepper__side">
      <div class="stepper__explain">
        <p class="stepper__running" data-running></p>
        <p class="stepper__text" data-text aria-live="polite"></p>
        <div class="stepper__buttons">
        <div class="stepper__controls">
          <button type="button" class="button" data-back>Back</button>
          <button type="button" class="button button--primary" data-next>Next line</button>
          <button type="button" class="button" data-skip>Skip function</button>
        </div>
        <div class="stepper__controls stepper__playback">
          <button type="button" class="button" data-play aria-pressed="false">Play</button>
          <label class="stepper__speed">
            Speed
            <select data-speed>
              <option value="slow">Slow</option>
              <option value="normal" selected>Normal</option>
              <option value="fast">Fast</option>
            </select>
          </label>
          <label class="stepper__scrub">
            <span data-count></span>
            <input type="range" min="0" value="0" step="1" data-range aria-label="Step" />
          </label>
        </div>
        </div>
        <p class="stepper__hint">Tip: press the left and right arrow keys to step.</p>
      </div>

      <div class="stepper__visual">
        <div class="stepper__drawing" data-drawing></div>

        <div class="readouts">
          <dl class="readouts__vars" data-vars></dl>
          <p class="readouts__key" data-key hidden></p>
          <div class="readouts__output">
            <h3>Output</h3>
            <pre data-output></pre>
          </div>
        </div>
      </div>

      <div class="trace" data-trace-wrap tabindex="0" role="region" aria-label="Trace table">
        <table>
          <caption>
            Trace table
          </caption>
          <thead data-trace-head></thead>
          <tbody data-trace-body></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { inlineCodeHtml } from "../lib/inline-code";
  import type { Algorithm, FunctionRange, Scenario, ScenarioStep } from "../lib/stepper";
  import { createQueueVisual } from "../lib/visuals/queue";
  import { createStackVisual } from "../lib/visuals/stack";

  const VISUALS = {
    stack: createStackVisual,
    queue: createQueueVisual,
    "circular-queue": (container: HTMLElement) => createQueueVisual(container, { circular: true }),
  };

  const STEP_DELAYS: Record<string, number> = { slow: 1800, normal: 1100, fast: 550 };

  function setUpStepper(root: HTMLElement) {
    const algorithms: Algorithm[] = JSON.parse(
      root.querySelector("[data-stepper-data]")!.textContent!,
    );
    const find = <T extends HTMLElement>(selector: string) =>
      root.querySelector<T>(selector)!;

    const algorithmTabs = root.querySelectorAll<HTMLButtonElement>("[data-algorithm]");
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-scenario]");
    const operationList = find("[data-operations]");
    const codePanel = find("[data-code]");
    const codeLines = find("[data-code-lines]");
    const back = find<HTMLButtonElement>("[data-back]");
    const next = find<HTMLButtonElement>("[data-next]");
    const skip = find<HTMLButtonElement>("[data-skip]");
    const play = find<HTMLButtonElement>("[data-play]");
    const speed = find<HTMLSelectElement>("[data-speed]");
    const range = find<HTMLInputElement>("[data-range]");
    const variables: string[] = JSON.parse(root.dataset.variables!);
    const visual = VISUALS[root.dataset.visual as keyof typeof VISUALS](find("[data-drawing]"));
    const key = find("[data-key]");
    key.textContent = visual.leftoverKey;
    const traceWrap = find("[data-trace-wrap]");
    const traceBody = find("[data-trace-body]");

    let algorithm = algorithms[0];
    let scenarioIndex = 0;
    let scenario = algorithm.scenarios[0];
    let current = 0;
    let lineFunctions: (FunctionRange | undefined)[] = [];
    let playTimer: number | undefined;
    let shouldUpdateUrl = false;

    const lastStep = () => scenario.steps.length - 1;

    function loadScenario(startStep = 0) {
      stopPlaying();
      scenario = algorithm.scenarios[scenarioIndex];
      current = Math.max(0, Math.min(lastStep(), startStep));
      algorithmTabs.forEach((tab, index) =>
        tab.setAttribute("aria-pressed", String(algorithms[index] === algorithm)),
      );
      tabs.forEach((tab, index) =>
        tab.setAttribute("aria-pressed", String(index === scenarioIndex)),
      );
      find("[data-algorithm-note]").innerHTML = inlineCodeHtml(algorithm.description);
      find("[data-summary]").textContent = scenario.summary;
      operationList.innerHTML = scenario.operations
        .map(
          (operation, index) =>
            `<li><button type="button" class="ops__button" data-operation="${index}">${
              operation.isCode ? `<code>${inlineCodeHtml(operation.label)}</code>` : operation.label
            }</button></li>`,
        )
        .join("");
      codeLines.innerHTML = scenario.lines
        .map((line) => `<li class="code__line"><code>${line || " "}</code></li>`)
        .join("");
      lineFunctions = scenario.lines.map((_, index) =>
        scenario.functions.find((fn) => index + 1 >= fn.start && index + 1 <= fn.end),
      );
      find("[data-trace-head]").innerHTML =
        `<tr><th scope="col">Line</th>${scenario.columns
          .map((column) => `<th scope="col"><code>${column}</code></th>`)
          .join("")}<th scope="col">Output</th></tr>`;
      range.max = String(lastStep());
      visual.load(algorithm, scenario);
      render();
    }

    function renderVars(step: ScenarioStep) {
      find("[data-vars]").innerHTML = variables
        .filter((name) => step.vars[name] !== undefined)
        .map((name) => {
          const value = String(step.vars[name]);
          return `<div><dt><code>${name}</code></dt><dd><code>${value === "" ? '""' : value}</code></dd></div>`;
        })
        .join("");
    }

    function renderTrace() {
      const visible = scenario.rows.filter((row) => row.step <= current);
      traceBody.innerHTML = visible
        .map(
          (row) =>
            `<tr class="${row.step === current ? "is-current" : ""}"><td><button type="button" class="trace__jump" data-step="${row.step}" aria-label="Go to step ${row.step + 1}, line ${row.line}">${row.line}</button></td>${row.cells
              .map((cell) => `<td><code>${cell}</code></td>`)
              .join("")}<td>${row.output}</td></tr>`,
        )
        .join("");
      traceWrap.scrollTop = traceWrap.scrollHeight;
    }

    function renderCode(step: ScenarioStep) {
      // Fade the functions that aren't running, except one being defined.
      const running = scenario.functions.find((fn) => fn.name === step.scope);
      codeLines.querySelectorAll<HTMLElement>(".code__line").forEach((line, index) => {
        const isCurrent = index === step.line - 1;
        const fn = lineFunctions[index];
        line.classList.toggle("is-current", isCurrent);
        line.classList.toggle(
          "is-dimmed",
          fn !== undefined && fn !== running && fn.start !== step.line,
        );
        if (isCurrent) {
          codePanel.scrollTop = line.offsetTop - codePanel.clientHeight / 2 + line.offsetHeight / 2;
        }
      });
    }

    function renderOperations(step: ScenarioStep) {
      operationList.querySelectorAll<HTMLElement>("[data-operation]").forEach((button, index) => {
        const isCurrent = index === step.operation;
        if (isCurrent) {
          button.setAttribute("aria-current", "step");
          operationList.scrollLeft =
            button.offsetLeft - operationList.clientWidth / 2 + button.offsetWidth / 2;
        } else {
          button.removeAttribute("aria-current");
        }
      });
    }

    function writeUrl() {
      if (!shouldUpdateUrl) return;
      const url = new URL(window.location.href);
      url.searchParams.set("algorithm", algorithm.id);
      url.searchParams.set("example", scenario.id);
      url.searchParams.set("step", String(current + 1));
      window.history.replaceState(null, "", url);
    }

    function render() {
      const step = scenario.steps[current];

      renderCode(step);
      renderOperations(step);
      find("[data-running]").textContent =
        step.scope === "<module>" ? "Running the main program" : `Running inside ${step.scope}`;
      find("[data-text]").innerHTML = inlineCodeHtml(step.text);
      find("[data-count]").textContent = `Step ${current + 1} of ${scenario.steps.length}`;
      range.value = String(current);
      back.disabled = current === 0;
      next.disabled = current === lastStep();
      skip.disabled = !scenario.steps[current + 1]?.inFunction;

      key.hidden = !visual.render(scenario.steps, current);
      renderVars(step);
      find("[data-output]").textContent = step.output.join("\n") || " ";
      renderTrace();
      writeUrl();
    }

    function show(index: number) {
      current = Math.max(0, Math.min(lastStep(), index));
      render();
    }

    function goTo(index: number) {
      stopPlaying();
      show(index);
    }

    // Runs the rest of the current function call and stops back in the main program.
    function skipFunction() {
      const target = scenario.steps.findIndex(
        (step, index) => index > current && !step.inFunction,
      );
      goTo(target === -1 ? lastStep() : target);
    }

    function stopPlaying() {
      window.clearInterval(playTimer);
      playTimer = undefined;
      play.textContent = "Play";
      play.setAttribute("aria-pressed", "false");
    }

    function startPlaying() {
      if (current === lastStep()) show(0);
      play.textContent = "Pause";
      play.setAttribute("aria-pressed", "true");
      playTimer = window.setInterval(() => {
        show(current + 1);
        if (current === lastStep()) stopPlaying();
      }, STEP_DELAYS[speed.value]);
    }

    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      algorithm = algorithms.find((item) => item.id === params.get("algorithm")) ?? algorithm;
      const exampleIndex = algorithm.scenarios.findIndex((item) => item.id === params.get("example"));
      if (exampleIndex !== -1) scenarioIndex = exampleIndex;
      const step = Number(params.get("step"));
      return Number.isInteger(step) && step >= 1 ? step - 1 : 0;
    }

    algorithmTabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        algorithm = algorithms[Number(tab.dataset.algorithm)];
        loadScenario();
      }),
    );
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        scenarioIndex = Number(tab.dataset.scenario);
        loadScenario();
      }),
    );
    operationList.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>("[data-operation]");
      if (button) goTo(scenario.operations[Number(button.dataset.operation)].step);
    });
    traceBody.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>("[data-step]");
      if (button) goTo(Number(button.dataset.step));
    });
    back.addEventListener("click", () => goTo(current - 1));
    next.addEventListener("click", () => goTo(current + 1));
    skip.addEventListener("click", skipFunction);
    play.addEventListener("click", () => (playTimer === undefined ? startPlaying() : stopPlaying()));
    speed.addEventListener("change", () => {
      if (playTimer === undefined) return;
      stopPlaying();
      startPlaying();
    });
    range.addEventListener("input", () => goTo(Number(range.value)));

    document.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if ((event.target as HTMLElement).closest("input, select, textarea, [contenteditable]")) return;
      const actions: Record<string, () => void> = {
        ArrowRight: () => goTo(current + 1),
        ArrowLeft: () => goTo(current - 1),
      };
      // Home and End only belong to the stepper while focus is inside it.
      if (root.contains(document.activeElement)) {
        actions.Home = () => goTo(0);
        actions.End = () => goTo(lastStep());
      }
      const action = actions[event.key];
      if (!action) return;
      event.preventDefault();
      action();
    });

    loadScenario(readUrl());
    shouldUpdateUrl = true;
  }

  document.querySelectorAll<HTMLElement>("[data-stepper]").forEach(setUpStepper);
</script>

<style is:global>
  .stepper {
    --cell-height: 56px;
  }

  .stepper__choice-label {
    margin: 0 0 6px;
    font-weight: 700;
  }

  .stepper__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stepper__tab {
    padding: 8px 14px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
    cursor: pointer;
  }

  .stepper__tab[aria-pressed="true"] {
    color: var(--sheet);
    background: var(--ink);
  }

  .stepper__summary {
    margin: 10px 0 16px;
  }

  .stepper__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: 16px;
    align-items: start;
  }

  .stepper__code,
  .stepper__explain,
  .stepper__visual,
  .trace {
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
  }

  .stepper__code {
    position: relative;
    max-height: 800px;
    padding: 12px 0;
    overflow: auto;
  }

  .code {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: code-line;
  }

  .code__line {
    display: flex;
    padding-right: 12px;
    counter-increment: code-line;
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre;
    transition: opacity 200ms ease;
  }

  .code__line::before {
    flex: none;
    width: 3em;
    padding-right: 1em;
    color: var(--muted);
    font-family: var(--code-font);
    text-align: right;
    content: counter(code-line);
  }

  .code__line.is-dimmed {
    opacity: 0.45;
  }

  .code__line.is-current code {
    margin-inline: -4px;
    padding-inline: 4px;
    background: var(--highlighter);
    border-radius: 2px;
    box-decoration-break: clone;
  }

  .py-keyword {
    font-weight: 700;
  }

  .py-string {
    color: var(--examiner);
  }

  .py-number {
    color: var(--pointer);
  }

  .py-comment {
    color: var(--muted);
    font-style: italic;
  }

  .stepper__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .stepper__explain {
    padding: 14px 16px;
  }

  .stepper__running {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .stepper__text {
    min-height: 4.65em;
    margin: 4px 0 12px;
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 68ch;
  }

  .stepper__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .button {
    padding: 8px 16px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
    cursor: pointer;
  }

  .button--primary {
    color: var(--sheet);
    font-weight: 700;
    background: var(--ink);
  }

  .button:disabled {
    color: var(--muted);
    background: var(--paper);
    border-color: var(--muted);
    cursor: not-allowed;
  }

  .stepper__scrub {
    display: flex;
    flex: 1 1 200px;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .stepper__scrub input {
    flex: 1;
    min-width: 80px;
    accent-color: var(--ink);
  }

  .stepper__visual {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px;
    padding: 18px 16px 14px;
  }

  .tower {
    position: relative;
    width: 300px;
    padding-left: 170px;
  }

  .tower.has-slot-above {
    padding-top: var(--cell-height);
  }

  .tower.has-slot-above .tower__floor {
    height: auto;
  }

  .tower.is-uncreated .tower__cells {
    opacity: 0.35;
  }

  .tower__pointer {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    width: 166px;
    height: var(--cell-height);
    padding-right: 18px;
    color: var(--pointer);
    font-weight: 700;
    white-space: nowrap;
    transform: translateY(calc(var(--rows-from-top, 0) * var(--cell-height)));
    transition: transform 280ms cubic-bezier(0.3, 0.9, 0.3, 1);
  }

  .tower__pointer[hidden] {
    display: none;
  }

  .tower__pointer::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0;
    height: 0;
    border-block: 9px solid transparent;
    border-left: 14px solid var(--pointer);
    transform: translateY(-50%);
    content: "";
  }

  .tower__pointer code {
    margin-left: auto;
    font-size: 0.875rem;
  }

  .tower__cells {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 2px solid var(--ink);
    border-bottom-width: 6px;
    border-top: 0;
  }

  .tower__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--cell-height);
    border-top: 2px solid var(--ink);
  }

  .tower__index {
    position: absolute;
    top: 3px;
    left: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .tower__value {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .tower__cell.is-in-stack {
    background: var(--ink);
  }

  .tower__cell.is-in-stack + .tower__cell.is-in-stack {
    border-top-color: var(--sheet);
  }

  .tower__cell.is-in-stack .tower__value,
  .tower__cell.is-in-stack .tower__index {
    color: var(--sheet);
  }

  .tower__cell.is-leftover {
    background: repeating-linear-gradient(135deg, var(--sheet) 0 6px, var(--paper) 6px 12px);
  }

  .tower__cell.is-leftover .tower__value {
    color: var(--muted);
    text-decoration: line-through;
  }

  .tower__cell.is-changed {
    animation: cell-stored 420ms ease-out;
  }

  @keyframes cell-stored {
    from {
      box-shadow: inset 0 0 0 4px var(--highlighter);
    }
    to {
      box-shadow: inset 0 0 0 0 var(--highlighter);
    }
  }

  .tower__floor {
    height: var(--cell-height);
    margin: 0;
    padding-top: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-align: center;
  }

  .readouts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .readouts__vars {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .readouts__vars div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--grid);
  }

  .readouts__vars dd {
    margin: 0;
    font-weight: 700;
  }

  .readouts__key {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .readouts__key[hidden] {
    display: none;
  }

  .readouts__output h3 {
    margin: 0 0 4px;
    font-size: 1rem;
  }

  .readouts__output pre {
    min-height: 3.5em;
    margin: 0;
    padding: 8px 10px;
    color: var(--sheet);
    font-family: var(--code-font);
    font-size: 0.875rem;
    background: var(--ink);
    border-radius: 4px;
    white-space: pre-wrap;
  }

  .trace {
    max-height: 290px;
    overflow: auto;
  }

  .trace table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .trace caption {
    padding: 10px 12px;
    font-size: 1rem;
    font-weight: 700;
    text-align: left;
  }

  .trace th {
    position: sticky;
    top: 0;
    padding: 6px 8px;
    font-weight: 700;
    text-align: center;
    background: var(--paper);
    box-shadow: inset 0 -2px 0 var(--ink);
  }

  .trace td {
    height: 2em;
    padding: 2px 8px;
    text-align: center;
    border: 1px solid var(--grid);
  }

  .trace tr.is-current td {
    background: var(--highlighter);
  }

  .queue {
    --queue-cell: 64px;
    position: relative;
    width: calc(var(--queue-slots) * var(--queue-cell));
    margin-inline: 40px;
    padding-block: 44px;
  }

  .queue.is-uncreated .queue__cells {
    opacity: 0.35;
  }

  .queue__cells {
    display: flex;
    margin: 0 0 0 var(--queue-cell);
    padding: 0;
    list-style: none;
    border: 2px solid var(--ink);
    border-left: 0;
    width: fit-content;
  }

  .queue__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--queue-cell);
    height: var(--queue-cell);
    border-left: 2px solid var(--ink);
  }

  .queue__index {
    position: absolute;
    top: 3px;
    left: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .queue__value {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .queue__cell.is-in-queue {
    background: var(--ink);
  }

