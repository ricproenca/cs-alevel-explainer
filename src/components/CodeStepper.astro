---
import type { Algorithm } from "../lib/stepper";

interface Props {
  algorithms: Algorithm[];
}

const { algorithms } = Astro.props;
const scenarios = algorithms[0].scenarios;
const data = JSON.stringify(algorithms).replace(/</g, "\\u003c");
---

<div class="stepper" data-stepper>
  <script type="application/json" data-stepper-data set:html={data} />

  <p class="stepper__choice-label" id="stepper-algorithm-label">Algorithm</p>
  <div class="stepper__tabs" role="group" aria-labelledby="stepper-algorithm-label">
    {
      algorithms.map((algorithm, index) => (
        <button
          type="button"
          class="stepper__tab"
          data-algorithm={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {algorithm.label}
        </button>
      ))
    }
  </div>
  <p class="stepper__summary" data-algorithm-note></p>

  <p class="stepper__choice-label" id="stepper-example-label">Example</p>
  <div class="stepper__tabs" role="group" aria-labelledby="stepper-example-label">
    {
      scenarios.map((scenario, index) => (
        <button
          type="button"
          class="stepper__tab"
          data-scenario={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {scenario.label}
        </button>
      ))
    }
  </div>
  <p class="stepper__summary" data-summary></p>

  <div class="stepper__grid">
    <div class="stepper__code" data-code tabindex="0" role="region" aria-label="Python code">
      <ol class="code" data-code-lines></ol>
    </div>

    <div class="stepper__side">
      <div class="stepper__explain">
        <p class="stepper__running" data-running></p>
        <p class="stepper__text" data-text aria-live="polite"></p>
        <div class="stepper__controls">
          <button type="button" class="button" data-back>Back</button>
          <button type="button" class="button button--primary" data-next>Next line</button>
          <label class="stepper__scrub">
            <span data-count></span>
            <input type="range" min="0" value="0" step="1" data-range />
          </label>
        </div>
      </div>

      <div class="stepper__visual">
        <div class="tower" data-tower>
          <div class="tower__pointer" data-pointer>
            <code data-pointer-label></code>
          </div>
          <ol class="tower__cells" data-cells></ol>
          <p class="tower__floor">Bottom of stack</p>
        </div>

        <div class="readouts">
          <dl class="readouts__vars" data-vars></dl>
          <p class="readouts__key" data-key hidden>Crossed out: still in the array, but no longer in the stack.</p>
          <div class="readouts__output">
            <h3>Output</h3>
            <pre data-output></pre>
          </div>
        </div>
      </div>

      <div class="trace" data-trace-wrap tabindex="0" role="region" aria-label="Trace table">
        <table>
          <caption>
            Trace table
          </caption>
          <thead data-trace-head></thead>
          <tbody data-trace-body></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { inlineCodeHtml } from "../lib/inline-code";
  import type { Algorithm, Scenario } from "../lib/stepper";

  function setUpStepper(root: HTMLElement) {
    const algorithms: Algorithm[] = JSON.parse(
      root.querySelector("[data-stepper-data]")!.textContent!,
    );
    const find = <T extends HTMLElement>(selector: string) =>
      root.querySelector<T>(selector)!;

    const algorithmTabs = root.querySelectorAll<HTMLButtonElement>("[data-algorithm]");
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-scenario]");
    const codePanel = find("[data-code]");
    const codeLines = find("[data-code-lines]");
    const back = find<HTMLButtonElement>("[data-back]");
    const next = find<HTMLButtonElement>("[data-next]");
    const range = find<HTMLInputElement>("[data-range]");
    const tower = find("[data-tower]");
    const pointer = find("[data-pointer]");
    const pointerLabel = find("[data-pointer-label]");
    const cells = find("[data-cells]");
    const traceWrap = find("[data-trace-wrap]");
    const traceBody = find("[data-trace-body]");

    let algorithm = algorithms[0];
    let scenarioIndex = 0;
    let scenario = algorithm.scenarios[0];
    let current = 0;
    let lastStack: string[] = [];

    function loadScenario() {
      scenario = algorithm.scenarios[scenarioIndex];
      current = 0;
      lastStack = [];
      algorithmTabs.forEach((tab, index) =>
        tab.setAttribute("aria-pressed", String(algorithms[index] === algorithm)),
      );
      tabs.forEach((tab, index) =>
        tab.setAttribute("aria-pressed", String(index === scenarioIndex)),
      );
      find("[data-algorithm-note]").innerHTML = inlineCodeHtml(algorithm.description);
      find("[data-summary]").textContent = scenario.summary;
      codeLines.innerHTML = scenario.lines
        .map((line) => `<li class="code__line"><code>${line || " "}</code></li>`)
        .join("");
      find("[data-trace-head]").innerHTML =
        `<tr><th scope="col">Line</th>${scenario.columns
          .map((column) => `<th scope="col"><code>${column}</code></th>`)
          .join("")}<th scope="col">Output</th></tr>`;
      range.max = String(scenario.steps.length - 1);
      const size = scenario.steps[scenario.steps.length - 1].vars.StackSize as number;
      cells.innerHTML = Array.from(
        { length: size },
        (_, position) => `<li class="tower__cell" data-cell="${size - 1 - position}">
            <span class="tower__index">${size - 1 - position}</span>
            <code class="tower__value"></code>
          </li>`,
      ).join("");
      render();
    }

    function renderTower(stack: string[] | undefined, top: number | undefined, size: number) {
      // A pointer that marks the next free space can sit one place above the array.
      const hasSlotAbove = algorithm.itemsBelowPointer === 0;
      const itemCount = top === undefined ? 0 : top + algorithm.itemsBelowPointer;
      const previousStack = scenario.steps[current - 1]?.vars.Stack as string[] | undefined;
      tower.classList.toggle("is-uncreated", stack === undefined);
      tower.classList.toggle("has-slot-above", hasSlotAbove);
      pointer.hidden = top === undefined;
      if (top !== undefined) {
        const rowsFromTop = hasSlotAbove ? size - top : size - 1 - top;
        pointer.style.setProperty("--rows-from-top", String(rowsFromTop));
        pointerLabel.textContent = `TopPointer = ${top}`;
      }
      cells.querySelectorAll<HTMLElement>("[data-cell]").forEach((cell) => {
        const index = Number(cell.dataset.cell);
        const value = stack?.[index] ?? "";
        const changed = stack !== undefined && lastStack[index] !== undefined && lastStack[index] !== value;
        cell.querySelector(".tower__value")!.textContent = value;
        // An item just stored counts as in the stack, even before the pointer moves past it.
        const justStored = top !== undefined && previousStack?.[index] !== value;
        const inStack = value !== "" && (index < itemCount || justStored);
        cell.classList.toggle("is-in-stack", inStack);
        cell.classList.toggle("is-leftover", top !== undefined && value !== "" && !inStack);
        cell.classList.toggle("is-changed", changed);
      });
      lastStack = stack ?? [];
      find("[data-key]").hidden = !cells.querySelector(".is-leftover");
    }

    function renderVars(step: Scenario["steps"][number]) {
      const rows: [string, string][] = [["StackSize", String(step.vars.StackSize ?? "")]];
      if (step.vars.Item !== undefined) rows.push(["Item", String(step.vars.Item)]);
      if (step.vars.Removed !== undefined) rows.push(["Removed", String(step.vars.Removed)]);
      find("[data-vars]").innerHTML = rows
        .filter(([name]) => step.vars[name] !== undefined)
        .map(
          ([name, value]) =>
            `<div><dt><code>${name}</code></dt><dd><code>${value === "" ? '""' : value}</code></dd></div>`,
        )
        .join("");
    }

    function renderTrace() {
      const visible = scenario.rows.filter((row) => row.step <= current);
      traceBody.innerHTML = visible
        .map(
          (row) =>
            `<tr class="${row.step === current ? "is-current" : ""}"><td>${row.line}</td>${row.cells
              .map((cell) => `<td><code>${cell}</code></td>`)
              .join("")}<td>${row.output}</td></tr>`,
        )
        .join("");
      traceWrap.scrollTop = traceWrap.scrollHeight;
    }

    function render() {
      const step = scenario.steps[current];
      const size = scenario.steps[scenario.steps.length - 1].vars.StackSize as number;

      codeLines.querySelectorAll<HTMLElement>(".code__line").forEach((line, index) => {
        const isCurrent = index === step.line - 1;
        line.classList.toggle("is-current", isCurrent);
        if (isCurrent) {
          codePanel.scrollTop = line.offsetTop - codePanel.clientHeight / 2 + line.offsetHeight / 2;
        }
      });

      find("[data-running]").textContent =
        step.scope === "<module>" ? "Running the main program" : `Running inside ${step.scope}`;
      find("[data-text]").innerHTML = inlineCodeHtml(step.text);
      find("[data-count]").textContent = `Step ${current + 1} of ${scenario.steps.length}`;
      range.value = String(current);
      back.disabled = current === 0;
      next.disabled = current === scenario.steps.length - 1;

      renderTower(step.vars.Stack as string[] | undefined, step.vars.TopPointer as number | undefined, size);
      renderVars(step);
      find("[data-output]").textContent = step.output.join("\n") || " ";
      renderTrace();
    }

    function goTo(index: number) {
      current = Math.max(0, Math.min(scenario.steps.length - 1, index));
      render();
    }

    algorithmTabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        algorithm = algorithms[Number(tab.dataset.algorithm)];
        loadScenario();
      }),
    );
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        scenarioIndex = Number(tab.dataset.scenario);
        loadScenario();
      }),
    );
    back.addEventListener("click", () => goTo(current - 1));
    next.addEventListener("click", () => goTo(current + 1));
    range.addEventListener("input", () => goTo(Number(range.value)));

    loadScenario();
  }

  document.querySelectorAll<HTMLElement>("[data-stepper]").forEach(setUpStepper);
</script>

<style is:global>
  .stepper {
    --cell-height: 56px;
  }

  .stepper__choice-label {
    margin: 0 0 6px;
    font-weight: 700;
  }

  .stepper__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stepper__tab {
    padding: 8px 14px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
    cursor: pointer;
  }

  .stepper__tab[aria-pressed="true"] {
    color: var(--sheet);
    background: var(--ink);
  }

  .stepper__summary {
    margin: 10px 0 16px;
  }

  .stepper__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: 16px;
    align-items: start;
  }

  .stepper__code,
  .stepper__explain,
  .stepper__visual,
  .trace {
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
  }

  .stepper__code {
    position: relative;
    max-height: 800px;
    padding: 12px 0;
    overflow: auto;
  }

  .code {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: code-line;
  }

  .code__line {
    display: flex;
    padding-right: 12px;
    counter-increment: code-line;
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre;
  }

  .code__line::before {
    flex: none;
    width: 3em;
    padding-right: 1em;
    color: var(--muted);
    font-family: var(--code-font);
    text-align: right;
    content: counter(code-line);
  }

  .code__line.is-current code {
    margin-inline: -4px;
    padding-inline: 4px;
    background: var(--highlighter);
    border-radius: 2px;
    box-decoration-break: clone;
  }

  .py-keyword {
    font-weight: 700;
  }

  .py-string {
    color: var(--examiner);
  }

  .py-number {
    color: var(--pointer);
  }

  .py-comment {
    color: var(--muted);
    font-style: italic;
  }

  .stepper__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .stepper__explain {
    padding: 14px 16px;
  }

  .stepper__running {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .stepper__text {
    min-height: 4.65em;
    margin: 4px 0 12px;
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 68ch;
  }

  .stepper__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .button {
    padding: 8px 16px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
    cursor: pointer;
  }

  .button--primary {
    color: var(--sheet);
    font-weight: 700;
    background: var(--ink);
  }

  .button:disabled {
    color: var(--muted);
    background: var(--paper);
    border-color: var(--muted);
    cursor: not-allowed;
  }

  .stepper__scrub {
    display: flex;
    flex: 1 1 200px;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .stepper__scrub input {
    flex: 1;
    min-width: 80px;
    accent-color: var(--ink);
  }

  .stepper__visual {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px;
    padding: 18px 16px 14px;
  }

  .tower {
    position: relative;
    width: 300px;
    padding-left: 170px;
  }

  .tower.has-slot-above {
    padding-top: var(--cell-height);
  }

  .tower.has-slot-above .tower__floor {
    height: auto;
  }

  .tower.is-uncreated .tower__cells {
    opacity: 0.35;
  }

  .tower__pointer {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    width: 166px;
    height: var(--cell-height);
    padding-right: 18px;
    color: var(--pointer);
    font-weight: 700;
    white-space: nowrap;
    transform: translateY(calc(var(--rows-from-top, 0) * var(--cell-height)));
    transition: transform 280ms cubic-bezier(0.3, 0.9, 0.3, 1);
  }

  .tower__pointer[hidden] {
    display: none;
  }

  .tower__pointer::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0;
    height: 0;
    border-block: 9px solid transparent;
    border-left: 14px solid var(--pointer);
    transform: translateY(-50%);
    content: "";
  }

  .tower__pointer code {
    margin-left: auto;
    font-size: 0.875rem;
  }

  .tower__cells {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 2px solid var(--ink);
    border-bottom-width: 6px;
    border-top: 0;
  }

  .tower__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--cell-height);
    border-top: 2px solid var(--ink);
  }

  .tower__index {
    position: absolute;
    top: 3px;
    left: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .tower__value {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .tower__cell.is-in-stack {
    background: var(--ink);
  }

  .tower__cell.is-in-stack + .tower__cell.is-in-stack {
    border-top-color: var(--sheet);
  }

  .tower__cell.is-in-stack .tower__value,
  .tower__cell.is-in-stack .tower__index {
    color: var(--sheet);
  }

  .tower__cell.is-leftover {
    background: repeating-linear-gradient(135deg, var(--sheet) 0 6px, var(--paper) 6px 12px);
  }

  .tower__cell.is-leftover .tower__value {
    color: var(--muted);
    text-decoration: line-through;
  }

  .tower__cell.is-changed {
    animation: cell-stored 420ms ease-out;
  }

  @keyframes cell-stored {
    from {
      box-shadow: inset 0 0 0 4px var(--highlighter);
    }
    to {
      box-shadow: inset 0 0 0 0 var(--highlighter);
    }
  }

  .tower__floor {
    height: var(--cell-height);
    margin: 0;
    padding-top: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-align: center;
  }

  .readouts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .readouts__vars {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .readouts__vars div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--grid);
  }

  .readouts__vars dd {
    margin: 0;
    font-weight: 700;
  }

  .readouts__key {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .readouts__key[hidden] {
    display: none;
  }

  .readouts__output h3 {
    margin: 0 0 4px;
    font-size: 1rem;
  }

  .readouts__output pre {
    min-height: 3.5em;
    margin: 0;
    padding: 8px 10px;
    color: var(--sheet);
    font-family: var(--code-font);
    font-size: 0.875rem;
    background: var(--ink);
    border-radius: 4px;
    white-space: pre-wrap;
  }

  .trace {
    max-height: 290px;
    overflow: auto;
  }

  .trace table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .trace caption {
    padding: 10px 12px;
    font-size: 1rem;
    font-weight: 700;
    text-align: left;
  }

  .trace th {
    position: sticky;
    top: 0;
    padding: 6px 8px;
    font-weight: 700;
    text-align: center;
    background: var(--paper);
    box-shadow: inset 0 -2px 0 var(--ink);
  }

  .trace td {
    height: 2em;
    padding: 2px 8px;
    text-align: center;
    border: 1px solid var(--grid);
  }

  .trace tr.is-current td {
    background: var(--highlighter);
  }

  @media (max-width: 1020px) {
    .stepper__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .stepper__code {
      max-height: 34vh;
    }

    .stepper__explain {
      position: sticky;
      bottom: 8px;
      z-index: 2;
      order: 3;
      box-shadow: 0 -6px 0 var(--paper);
    }

    .stepper__text {
      min-height: 6.2em;
      font-size: 1rem;
    }

    .trace {
      max-height: 240px;
    }
  }

  @media (max-width: 600px) {
    .stepper {
      --cell-height: 42px;
    }

    .stepper__code {
      max-height: 23vh;
      padding: 6px 0;
    }

    .code__line {
      font-size: 0.8125rem;
    }

    .code__line::before {
      width: 2.6em;
      padding-right: 0.7em;
    }

    .stepper__explain {
      padding: 10px 12px;
    }

    .stepper__running,
    .stepper__scrub input {
      display: none;
    }

    .stepper__text {
      min-height: 7.75em;
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 0.9375rem;
      line-height: 1.4;
    }

    .stepper__scrub {
      flex: 0 1 auto;
    }

    .stepper__visual {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 10px 12px;
    }

    .tower__floor {
      padding-top: 2px;
    }

    .tower {
      width: 100%;
      padding-left: 150px;
    }

    .tower__pointer {
      width: 146px;
    }
  }
</style>
